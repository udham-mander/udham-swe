{
  "description": "flash-on-done: flash the Windows Terminal window when Claude finishes a long reply (Windows only; no-op elsewhere). See docs/flash-on-done.md.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on-prompt.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on-stop.sh\"",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  }
}
